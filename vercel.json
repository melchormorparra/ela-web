{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "public/**/*", "use": "@vercel/static", "config": { "zeroConfig": true } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/admin.html", "dest": "/public/admin.html" },
    { "src": "/admin", "dest": "/public/admin.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "crons": [
    {
      "path": "/api/send-remesa",
      "schedule": "0 8 1 * *"
    },
    {
      "path": "/api/monthly-investment",
      "schedule": "0 12 1 * *"
    }
  ]
}
