{
  "version": 2,
  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node@2.4.0"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/public/admin.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
